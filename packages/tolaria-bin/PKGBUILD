# Maintainer: Local package maintained by the user
pkgname=tolaria-bin
pkgver=2026.8.19
pkgrel=1
pkgdesc="Latest stable Tolaria GitHub release"
arch=('x86_64')
url="https://github.com/refactoringhq/tolaria"
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1')
makedepends=('curl' 'jq' 'libarchive')
provides=('tolaria')
conflicts=('tolaria' 'tolaria-alpha-bin')
options=('!emptydirs' '!strip')

# The release asset is resolved dynamically in prepare().
source=()
sha256sums=()

prepare() {
	cd "$srcdir"

	local release_file tag release_date year month day version asset_row deb_asset asset_digest
	if [[ -f /work/release.json ]]; then
		release_file=/work/release.json
	else
		release_file="$srcdir/release.json"
		curl -fsSL https://api.github.com/repos/refactoringhq/tolaria/releases -o "$release_file"
	fi
	tag="$(jq -r '[.[] | select((.prerelease | not) and (.draft | not))][0].tag_name' "$release_file")"
	[[ "$tag" =~ ^v[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]
	release_date=${tag#v}
	IFS=- read -r year month day <<< "$release_date"
	version="$((10#$year)).$((10#$month)).$((10#$day))"
	test "$version" = "$pkgver"
	asset_row="$(jq -r --arg tag "$tag" \
		'.[] | select(.tag_name == $tag) | .assets[] | select(.name | endswith("_amd64.deb")) | [.name, .digest] | @tsv' \
		"$release_file" | head -n1)"
	IFS=$'\t' read -r deb_asset asset_digest <<< "$asset_row"

	test -n "$tag" -a "$tag" != "null"
	test -n "$deb_asset"
	[[ "$asset_digest" =~ ^sha256:[0-9a-fA-F]{64}$ ]]

	curl -fL -o tolaria.deb \
		"https://github.com/refactoringhq/tolaria/releases/download/$tag/$deb_asset"
	printf '%s  %s\n' "${asset_digest#sha256:}" tolaria.deb | sha256sum -c -

	mkdir -p extracted
	bsdtar -xf tolaria.deb -C extracted
	bsdtar -xf extracted/data.tar.gz -C extracted
}

package() {
	cp -a "$srcdir/extracted/usr" "$pkgdir/"

	# Remove Debian-specific metadata, matching the official tolaria-bin package.
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/lintian"
}
